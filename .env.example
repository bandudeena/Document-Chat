# RAG_AGENT_MAX_SEARCHES=4
# RAG_AGENT_MAX_ROUNDS=3
# RAG_TOP_K=5
# RAG_SCORE_THRESHOLD=0.15
# RAG_MAX_UPLOAD_MB=20
