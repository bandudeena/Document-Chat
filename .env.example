# AWS credentials (or configure ~/.aws and use AWS_PROFILE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- optional overrides (defaults shown) ---
# RAG_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
